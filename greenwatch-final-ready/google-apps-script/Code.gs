const DB_SCHEMA={users:['id','name','email','phone','access_code_hash','role','status','created_at','updated_at'],auth_sessions:['id','user_id','token_hash','expires_at','created_at'],sessions:['id','user_id','phone','status','plan_id','consent','created_at','updated_at'],activities:['id','user_id','session_id','category','event','metadata_json','created_at'],locations:['id','user_id','session_id','label','latitude','longitude','consent','created_at'],recovery:['id','user_id','session_id','state','note','created_at','updated_at'],plans:['id','name','price','currency','duration_days','features_json','status','created_at','updated_at'],subscriptions:['id','user_id','plan_id','status','start_at','end_at','created_at','updated_at'],payments:['id','user_id','subscription_id','amount','currency','status','reference','created_at'],site_content:['id','section','key','value','updated_at'],faq:['id','question','answer','sort_order','status','updated_at'],testimonials:['id','name','role','content','rating','status','updated_at'],settings:['key','value','updated_at'],audit_logs:['id','action','table_name','record_id','actor','created_at']};
function ss_(){return SpreadsheetApp.getActiveSpreadsheet()}function now_(){return Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd HH:mm:ss')}function plusHours_(h){return Utilities.formatDate(new Date(Date.now()+h*3600000),Session.getScriptTimeZone(),'yyyy-MM-dd HH:mm:ss')}function uid_(p){return p+'-'+Utilities.getUuid().slice(0,10).toUpperCase()}function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}function hash_(s){const b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s),Utilities.Charset.UTF_8);return b.map(x=>('0'+((x<0?x+256:x).toString(16))).slice(-2)).join('')}
function table_(n){if(!DB_SCHEMA[n])throw new Error('Unknown table');let sh=ss_().getSheetByName(n);if(!sh)sh=ss_().insertSheet(n);if(sh.getLastRow()===0){sh.appendRow(DB_SCHEMA[n]);sh.setFrozenRows(1)}return sh}function initDatabase(){Object.keys(DB_SCHEMA).forEach(table_);seed_()}function seed_(){const sh=table_('plans');if(sh.getLastRow()===1){const t=now_();sh.appendRow(['P-STARTER','Starter',19,'USD',30,'[]','active',t,t]);sh.appendRow(['P-PRO','Professional',49,'USD',30,'[]','active',t,t]);sh.appendRow(['P-BIZ','Business',99,'USD',30,'[]','active',t,t])}}
function list_(n){const v=table_(n).getDataRange().getDisplayValues();if(v.length<2)return[];const h=v[0];return v.slice(1).map(r=>Object.fromEntries(h.map((x,i)=>[x,r[i]])))}function add_(n,o){const c=DB_SCHEMA[n];table_(n).appendRow(c.map(k=>o[k]??''))}function find_(n,c,v){return list_(n).find(r=>String(r[c]).toLowerCase()===String(v).toLowerCase())||null}function rowPk_(n,v){const sh=table_(n),d=sh.getDataRange().getDisplayValues();for(let i=1;i<d.length;i++)if(String(d[i][0])===String(v))return{i:i+1,row:d[i]};return null}
function adminKey_(){return PropertiesService.getScriptProperties().getProperty('ADMIN_KEY')||''}function admin_(p){if(!adminKey_())throw new Error('ADMIN_KEY is not configured');if(String(p.admin_key||'')!==adminKey_())throw new Error('Invalid admin key')}function audit_(a,t,id,actor){add_('audit_logs',{id:uid_('AUD'),action:a,table_name:t,record_id:id,actor:actor,created_at:now_()})}
function customer_(tok){if(!tok)throw new Error('AUTH_REQUIRED');const s=find_('auth_sessions','token_hash',hash_(tok));if(!s)throw new Error('AUTH_REQUIRED');if(new Date(s.expires_at.replace(' ','T'))<new Date())throw new Error('AUTH_REQUIRED');const u=find_('users','id',s.user_id);if(!u||u.status!=='active')throw new Error('AUTH_REQUIRED');return u}function mine_(n,u){return list_(n).filter(r=>String(r.user_id)===String(u))}function owns_(u,s){return mine_('sessions',u).some(x=>x.id===s)}function publicUser_(u){return{id:u.id,name:u.name,email:u.email,phone:u.phone,role:u.role,status:u.status}}
function doGet(e){try{initDatabase();const p=e.parameter||{},a=String(p.action||'');if(a==='admin_ping'){admin_(p);return out_({ok:true})}if(a==='admin_schema'){admin_(p);return out_({ok:true,schema:DB_SCHEMA})}if(a==='admin_list'){admin_(p);return out_({ok:true,records:list_(String(p.table||''))})}if(a.startsWith('customer_')){const u=customer_(p.customer_token);if(a==='customer_me')return out_({ok:true,user:publicUser_(u)});if(a==='customer_bootstrap')return out_({ok:true,user:publicUser_(u),sessions:mine_('sessions',u.id).reverse(),activities:mine_('activities',u.id).reverse(),locations:mine_('locations',u.id).reverse(),recovery:mine_('recovery',u.id).reverse()});if(a==='customer_sessions')return out_({ok:true,records:mine_('sessions',u.id).reverse()});if(a==='customer_activities')return out_({ok:true,records:mine_('activities',u.id).reverse()});if(a==='customer_locations')return out_({ok:true,records:mine_('locations',u.id).reverse()});if(a==='customer_billing')return out_({ok:true,sessions:mine_('sessions',u.id).reverse(),subscriptions:mine_('subscriptions',u.id).reverse(),payments:mine_('payments',u.id).reverse()})}return out_({ok:false,error:'Unknown action'})}catch(x){return out_({ok:false,error:String(x.message||x)})}}
function doPost(e){try{initDatabase();const p=e.parameter||{},a=String(p.action||'');if(a==='create_session'){const phone=String(p.phone||'').replace(/[^\d+]/g,'');if(phone.length<8||phone.length>20)throw new Error('Invalid phone');if(String(p.consent||'')!=='YES')throw new Error('Consent required');const t=now_(),sid=uid_('DEMO');add_('sessions',{id:sid,user_id:'',phone,status:'Demo Active',plan_id:'P-STARTER',consent:'YES',created_at:t,updated_at:t});add_('activities',{id:uid_('ACT'),user_id:'',session_id:sid,category:'Demo',event:'Consented demo session created',metadata_json:'{}',created_at:t});return out_({ok:true,id:sid})}if(a==='customer_login'){const u=find_('users','email',String(p.email||'').trim().toLowerCase());if(!u||u.status!=='active'||hash_(String(p.access_code||''))!==u.access_code_hash)throw new Error('Invalid email or access code');const raw=Utilities.getUuid()+Utilities.getUuid();add_('auth_sessions',{id:uid_('AUTH'),user_id:u.id,token_hash:hash_(raw),expires_at:plusHours_(12),created_at:now_()});return out_({ok:true,token:raw})}if(a==='customer_logout'){const u=customer_(p.customer_token),h=hash_(p.customer_token),rows=list_('auth_sessions'),sh=table_('auth_sessions');for(let i=rows.length-1;i>=0;i--)if(rows[i].token_hash===h)sh.deleteRow(i+2);return out_({ok:true})}if(a==='customer_add_location'){const u=customer_(p.customer_token);if(String(p.consent)!=='YES'||!owns_(u.id,String(p.session_id)))throw new Error('Consent/session invalid');const lat=Number(p.latitude),lng=Number(p.longitude);if(!isFinite(lat)||!isFinite(lng)||Math.abs(lat)>90||Math.abs(lng)>180)throw new Error('Invalid coordinates');const t=now_();add_('locations',{id:uid_('LOC'),user_id:u.id,session_id:String(p.session_id),label:String(p.label||''),latitude:lat,longitude:lng,consent:'YES',created_at:t});add_('activities',{id:uid_('ACT'),user_id:u.id,session_id:String(p.session_id),category:'Location',event:'Consented location saved',metadata_json:'{}',created_at:t});return out_({ok:true})}if(a==='customer_add_recovery'){const u=customer_(p.customer_token);if(!owns_(u.id,String(p.session_id)))throw new Error('Session invalid');const t=now_();add_('recovery',{id:uid_('REC'),user_id:u.id,session_id:String(p.session_id),state:String(p.state||'Open'),note:String(p.note||'').slice(0,500),created_at:t,updated_at:t});return out_({ok:true})}
if(a==='admin_create_customer'){admin_(p);const email=String(p.email||'').trim().toLowerCase();if(find_('users','email',email))throw new Error('Email already exists');const t=now_(),uid=uid_('USR'),sid=uid_('SES'),pid=String(p.plan_id||'P-STARTER');add_('users',{id:uid,name:String(p.name||''),email,phone:String(p.phone||''),access_code_hash:hash_(String(p.access_code||'')),role:'customer',status:'active',created_at:t,updated_at:t});add_('sessions',{id:sid,user_id:uid,phone:String(p.phone||''),status:'Demo Active',plan_id:pid,consent:'YES',created_at:t,updated_at:t});add_('subscriptions',{id:uid_('SUB'),user_id:uid,plan_id:pid,status:'active',start_at:t,end_at:plusHours_(24*30),created_at:t,updated_at:t});add_('activities',{id:uid_('ACT'),user_id:uid,session_id:sid,category:'Account',event:'Customer account created',metadata_json:'{}',created_at:t});return out_({ok:true,user_id:uid,session_id:sid})}
if(a==='admin_insert'){admin_(p);const n=String(p.table||''),o=JSON.parse(String(p.record_json||'{}')),c=DB_SCHEMA[n];if(!c)throw new Error('Unknown table');if(c[0]==='id'&&!o.id)o.id=uid_(n.slice(0,3).toUpperCase());if(c.includes('created_at')&&!o.created_at)o.created_at=now_();if(c.includes('updated_at'))o.updated_at=now_();add_(n,o);audit_('insert',n,o[c[0]],'admin');return out_({ok:true})}if(a==='admin_update'){admin_(p);const n=String(p.table||''),c=DB_SCHEMA[n],f=rowPk_(n,p.pk_value);if(!f)throw new Error('Record not found');const o=JSON.parse(String(p.record_json||'{}')),old=Object.fromEntries(c.map((k,i)=>[k,f.row[i]])),m={...old,...o};if(c.includes('updated_at'))m.updated_at=now_();table_(n).getRange(f.i,1,1,c.length).setValues([c.map(k=>m[k]??'')]);return out_({ok:true})}if(a==='admin_delete'){admin_(p);const n=String(p.table||''),f=rowPk_(n,p.pk_value);if(!f)throw new Error('Record not found');table_(n).deleteRow(f.i);return out_({ok:true})}return out_({ok:false,error:'Unknown action'})}catch(x){return out_({ok:false,error:String(x.message||x)})}}